#
# Dolphin right-click integration for the Flatpak build. Flatpak does not export
# service menus, so install this on the host:
#   cp flatpak/servicemenus-host/*.desktop ~/.local/share/kio/servicemenus/
#   kbuildsycoca6

[Desktop Entry]
Type=Application
Name=Encrypt with KDecrypt
MimeType=all/allfiles;
Actions=encryptWithKdecrypt;
X-KDE-Priority=TopLevel

[Desktop Action encryptWithKdecrypt]
Name=Encrypt with KDecrypt
Name[pl]=Zaszyfruj przez KDecrypt
Name[de]=Mit KDecrypt verschlüsseln
Name[fr]=Chiffrer avec KDecrypt
Name[zh_CN]=使用 KDecrypt 加密
Name[ja]=KDecrypt で暗号化
Icon=document-encrypt
Exec=flatpak run org.guidlab.kdecrypt --encrypt %F
