[Desktop Entry]
Type=Application
Name=Decrypt with KDecrypt
MimeType=application/pgp-encrypted;application/pgp;application/pgp-keys;application/pgp-signature;
Actions=decryptWithKdecrypt;
X-KDE-Priority=TopLevel

[Desktop Action decryptWithKdecrypt]
Name=Decrypt with KDecrypt
Name[pl]=Odszyfruj przez KDecrypt
Name[de]=Mit KDecrypt entschlüsseln
Name[fr]=Déchiffrer avec KDecrypt
Name[zh_CN]=使用 KDecrypt 解密
Name[ja]=KDecrypt で復号
Icon=document-decrypt
Exec=kdecrypt %F
